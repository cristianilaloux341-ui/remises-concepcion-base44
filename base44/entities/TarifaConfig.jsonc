{
  "name": "TarifaConfig",
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "properties": {
    "clave_modificacion": {
      "type": "string",
      "description": "Clave num\u00e9rica para habilitar la edici\u00f3n de tarifas"
    },
    "bajada_bandera": {
      "type": "number",
      "default": 0,
      "description": "Importe fijo al iniciar un viaje (diurno)"
    },
    "valor_ficha": {
      "type": "number",
      "default": 0,
      "description": "Importe que suma cada ficha de distancia"
    },
    "metros_por_ficha": {
      "type": "number",
      "default": 0,
      "description": "Distancia necesaria para sumar una ficha"
    },
    "valor_ficha_espera": {
      "type": "number",
      "default": 0,
      "description": "Importe que suma cada ficha mientras est\u00e1 detenido"
    },
    "segundos_por_ficha_espera": {
      "type": "number",
      "default": 0,
      "description": "Tiempo completo detenido para sumar una ficha"
    },
    "tolerancia_espera_segundos": {
      "type": "number",
      "default": 0,
      "description": "Segundos de gracia antes de cobrar espera"
    },
    "nocturna_bajada_bandera": {
      "type": "number",
      "default": 0,
      "description": "Bajada de bandera nocturna"
    },
    "nocturna_hora_inicio": {
      "type": "number",
      "default": 0,
      "description": "Hora de inicio de tarifa nocturna (0-23)"
    },
    "nocturna_hora_fin": {
      "type": "number",
      "default": 0,
      "description": "Hora de fin de tarifa nocturna (0-23)"
    },
    "minutos_libre_post_viaje": {
      "type": "number",
      "default": 0,
      "description": "Minutos que debe esperar el chofer antes de poder ponerse libre luego de completar un viaje (0 = sin restricci\u00f3n)"
    },
    "tiempo_maximo_respuesta_segundos": {
      "type": "number",
      "default": 60,
      "description": "Segundos m\u00e1ximos que tiene el chofer para aceptar un viaje antes de que se reasigne"
    },
    "auto_reasignacion_activa": {
      "type": "boolean",
      "default": true,
      "description": "Indica si el sistema debe reasignar autom\u00e1ticamente los viajes si los choferes no responden a tiempo."
    },
    "auto_aceptar_viajes": {
      "type": "boolean",
      "default": false,
      "description": "Si est\u00e1 activo, al asignar un viaje pasa directo a aceptado/en_viaje (ideal para radio)."
    },
    "precio_por_metro": {
      "type": "number",
      "default": 0,
      "description": "Legacy"
    },
    "precio_por_minuto_corrido": {
      "type": "number",
      "default": 0,
      "description": "Legacy"
    },
    "precio_por_minuto_espera": {
      "type": "number",
      "default": 0,
      "description": "Legacy"
    },
    "nocturna_precio_por_metro": {
      "type": "number",
      "default": 0,
      "description": "Legacy"
    },
    "nocturna_precio_por_minuto_corrido": {
      "type": "number",
      "default": 0,
      "description": "Legacy"
    },
    "nocturna_precio_por_minuto_espera": {
      "type": "number",
      "default": 0,
      "description": "Legacy"
    }
  },
  "required": []
}