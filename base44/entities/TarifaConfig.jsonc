{
  "name": "TarifaConfig",
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "properties": {
    "clave_modificacion": {
      "type": "string",
      "description": "Clave num\u00e9rica para habilitar la edici\u00f3n de tarifas"
    },
    "bajada_bandera": {
      "type": "number",
      "default": 0,
      "description": "Importe fijo al iniciar un viaje (diurno)"
    },
    "valor_ficha": {
      "type": "number",
      "default": 0,
      "description": "Importe que suma cada ficha de distancia"
    },
    "metros_por_ficha": {
      "type": "number",
      "default": 0,
      "description": "Distancia necesaria para sumar una ficha"
    },
    "valor_ficha_espera": {
      "type": "number",
      "default": 0,
      "description": "Importe que suma cada ficha mientras est\u00e1 detenido"
    },
    "segundos_por_ficha_espera": {
      "type": "number",
      "default": 0,
      "description": "Tiempo completo detenido para sumar una ficha"
    },
    "tolerancia_espera_segundos": {
      "type": "number",
      "default": 0,
      "description": "Segundos de gracia antes de cobrar espera"
    },
    "nocturna_bajada_bandera": {
      "type": "number",
      "default": 0,
      "description": "Bajada de bandera nocturna"
    },
    "nocturna_hora_inicio": {
      "type": "number",
      "default": 0,
      "description": "Hora de inicio de tarifa nocturna (0-23)"
    },
    "nocturna_hora_fin": {
      "type": "number",
      "default": 0,
      "description": "Hora de fin de tarifa nocturna (0-23)"
    },
    "minutos_bloqueo_post_aceptacion": {
      "type": "number",
      "default": 0,
      "description": "Minutos contados desde la aceptaci\u00f3n antes de que el chofer pueda volver a posicionarse en una base"
    },
    "segundos_aceptado_antes_en_camino": {
      "type": "number",
      "default": 60,
      "description": "Espera m\u00ednima autoritativa desde Aceptado antes de permitir pasar a En camino; sin cron\u00f3metro visible en APK"
    },
    "segundos_en_camino_antes_en_viaje": {
      "type": "number",
      "default": 120,
      "description": "Espera m\u00ednima autoritativa desde En camino antes de permitir Pasajero a bordo/En viaje; sin cron\u00f3metro visible en APK"
    },
    "tiempo_maximo_respuesta_segundos": {
      "type": "number",
      "default": 60,
      "description": "Segundos m\u00e1ximos que tiene el chofer para aceptar un viaje antes de que se reasigne"
    },
    "auto_reasignacion_activa": {
      "type": "boolean",
      "default": true,
      "description": "Indica si el sistema debe reasignar autom\u00e1ticamente los viajes si los choferes no responden a tiempo."
    }
  },
  "required": []
}