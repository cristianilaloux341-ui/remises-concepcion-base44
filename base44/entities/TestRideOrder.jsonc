{
  "name": "TestRideOrder",
  "type": "object",
  "properties": {
    "client_name": {
      "type": "string"
    },
    "pickup_address": {
      "type": "string"
    },
    "dropoff_address": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendiente",
        "procesando_despacho",
        "esperando_confirmacion_manual",
        "ofrecido",
        "aceptado",
        "en_camino",
        "en_viaje",
        "completado",
        "cancelado",
        "rechazado"
      ],
      "default": "pendiente"
    },
    "reservation_token": {
      "type": "string"
    },
    "manual_reservation_token": {
      "type": "string"
    },
    "reserved_driver_id": {
      "type": "string"
    },
    "driver_id": {
      "type": "string"
    },
    "driver_name": {
      "type": "string"
    },
    "offered_driver_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assignment_attempt": {
      "type": "number",
      "default": 1
    },
    "offerExpiresAt": {
      "type": "number"
    },
    "fare": {
      "type": "number"
    },
    "zone": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "scheduled_for": {
      "type": "string"
    },
    "processingOwnerId": {
      "type": "string"
    },
    "processingLeaseVersion": {
      "type": "number",
      "default": 0
    },
    "processingLeaseExpiresAt": {
      "type": "number"
    },
    "processingAction": {
      "type": "string"
    },
    "processingOperationKey": {
      "type": "string"
    },
    "processingPhase": {
      "type": "string"
    },
    "lastCompletedOperationKey": {
      "type": "string"
    },
    "lastCompletedAction": {
      "type": "string"
    },
    "lastCompletedResult": {
      "type": "string"
    },
    "lastCompletedAt": {
      "type": "number"
    },
    "lastCompletedOfferVersion": {
      "type": "number"
    },
    "pendingEffectKey": {
      "type": "string"
    },
    "pendingEffectType": {
      "type": "string"
    },
    "pendingEffectStatus": {
      "type": "string"
    },
    "pendingEffectCorrelationId": {
      "type": "string"
    },
    "pendingEffectVersion": {
      "type": "number",
      "default": 0
    }
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "required": []
}