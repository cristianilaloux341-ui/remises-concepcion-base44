{
  "name": "PanicAlert",
  "type": "object",
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "properties": {
    "driver_id": {
      "type": "string",
      "description": "ID del chofer que activ\u00f3 la alerta"
    },
    "driver_name": {
      "type": "string",
      "description": "Nombre del chofer"
    },
    "vehicle_plate": {
      "type": "string",
      "description": "Patente del veh\u00edculo"
    },
    "current_lat": {
      "type": "number",
      "description": "Latitud de la ubicaci\u00f3n del p\u00e1nico"
    },
    "current_lng": {
      "type": "number",
      "description": "Longitud de la ubicaci\u00f3n del p\u00e1nico"
    },
    "status": {
      "type": "string",
      "enum": [
        "activo",
        "atendido",
        "cancelado"
      ],
      "default": "activo",
      "description": "Estado de la alerta"
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionales del operador"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora en que la alerta fue atendida"
    },
    "resolved_by_id": {
      "type": "string",
      "description": "ID del operador que atendi\u00f3 la alerta"
    },
    "resolved_by_name": {
      "type": "string",
      "description": "Nombre del operador que atendi\u00f3 la alerta"
    }
  },
  "required": [
    "driver_id",
    "driver_name"
  ]
}