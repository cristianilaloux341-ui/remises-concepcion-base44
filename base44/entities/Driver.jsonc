{
  "name": "Driver",
  "type": "object",
  "rls": {
    "read": true,
    "create": false,
    "update": true,
    "delete": true
  },
  "properties": {
    "name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "phone2": {
      "type": "string",
      "description": "Tel\u00e9fono de contacto secundario"
    },
    "fecha_nacimiento": {
      "type": "string",
      "format": "date",
      "description": "Fecha de nacimiento del conductor"
    },
    "dni": {
      "type": "string",
      "description": "N\u00famero de DNI"
    },
    "direccion": {
      "type": "string",
      "description": "Direcci\u00f3n del conductor"
    },
    "photo_url": {
      "type": "string",
      "description": "URL de la foto del conductor"
    },
    "carnet_categoria": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F",
        "G"
      ],
      "description": "Categor\u00eda del carnet de conducir"
    },
    "vehicle_model": {
      "type": "string",
      "description": "ID del m\u00f3vil asignado"
    },
    "vehicle_plate": {
      "type": "string"
    },
    "vehicle_color": {
      "type": "string"
    },
    "seguro_riesgos_personales_vencimiento": {
      "type": "string",
      "format": "date",
      "description": "Vencimiento seguro de riesgos personales del conductor"
    },
    "buena_conducta": {
      "type": "boolean",
      "default": true,
      "description": "Certificado de buena conducta vigente"
    },
    "buena_conducta_vencimiento": {
      "type": "string",
      "format": "date",
      "description": "Vencimiento buena conducta"
    },
    "notas": {
      "type": "string",
      "description": "Notas internas de la comisi\u00f3n (recordatorios, faltantes, observaciones)"
    },
    "status": {
      "type": "string",
      "enum": [
        "disponible",
        "en_viaje",
        "no_disponible"
      ],
      "default": "disponible"
    },
    "current_base": {
      "type": "string",
      "enum": [
        "1-Puerto",
        "2-Plaza",
        "3-Columna",
        "4-Base",
        "5-Cementerio",
        "6-D\u00edaz V\u00e9lez",
        "7-Don Bosco",
        "8-Monumento"
      ],
      "description": "Base actual donde est\u00e1 esperando"
    },
    "queue_position": {
      "type": "number",
      "description": "Posici\u00f3n en la cola de la base"
    },
    "queue_entered_at": {
      "type": "string",
      "description": "Timestamp de cuando entr\u00f3 a la cola"
    },
    "current_lat": {
      "type": "number"
    },
    "current_lng": {
      "type": "number"
    },
    "user_id": {
      "type": "string",
      "description": "ID del usuario vinculado al chofer"
    },
    "push_subscription": {
      "type": "string",
      "description": "JSON serializado de la PushSubscription del navegador"
    }
  },
  "required": [
    "name",
    "phone",
    "vehicle_plate"
  ]
}