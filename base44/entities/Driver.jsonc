{
  "name": "Driver",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "vehicle_model": {
      "type": "string"
    },
    "vehicle_plate": {
      "type": "string"
    },
    "vehicle_color": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "disponible",
        "en_viaje",
        "no_disponible"
      ],
      "default": "disponible"
    },
    "current_base": {
      "type": "string",
      "enum": [
        "Puerto",
        "Plaza",
        "Columna",
        "Cementerio",
        "Don Bosco",
        "D\u00edaz V\u00e9lez",
        "Monumento"
      ],
      "description": "Base actual donde est\u00e1 esperando"
    },
    "queue_position": {
      "type": "number",
      "description": "Posici\u00f3n en la cola de la base"
    },
    "queue_entered_at": {
      "type": "string",
      "description": "Timestamp de cuando entr\u00f3 a la cola"
    },
    "current_lat": {
      "type": "number"
    },
    "current_lng": {
      "type": "number"
    },
    "user_id": {
      "type": "string",
      "description": "ID del usuario vinculado al chofer"
    }
  },
  "required": [
    "name",
    "phone",
    "vehicle_plate"
  ]
}