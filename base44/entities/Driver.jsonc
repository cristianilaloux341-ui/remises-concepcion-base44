{
  "name": "Driver",
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": null,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "properties": {
    "name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "phone2": {
      "type": "string",
      "description": "Teléfono de contacto secundario"
    },
    "fecha_nacimiento": {
      "type": "string",
      "format": "date",
      "description": "Fecha de nacimiento del conductor"
    },
    "dni": {
      "type": "string",
      "description": "Número de DNI"
    },
    "direccion": {
      "type": "string",
      "description": "Dirección del conductor"
    },
    "photo_url": {
      "type": "string",
      "description": "URL de la foto del conductor"
    },
    "carnet_categoria": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F",
        "G"
      ],
      "description": "Categoría del carnet de conducir"
    },
    "vehicle_model": {
      "type": "string",
      "description": "ID del móvil asignado"
    },
    "vehicle_plate": {
      "type": "string"
    },
    "vehicle_color": {
      "type": "string"
    },
    "seguro_riesgos_personales_vencimiento": {
      "type": "string",
      "format": "date",
      "description": "Vencimiento seguro de riesgos personales del conductor"
    },
    "buena_conducta": {
      "type": "boolean",
      "default": true,
      "description": "Certificado de buena conducta vigente"
    },
    "buena_conducta_vencimiento": {
      "type": "string",
      "format": "date",
      "description": "Vencimiento buena conducta"
    },
    "notas": {
      "type": "string",
      "description": "Notas internas de la comisión"
    },
    "pin": {
      "type": "string",
      "description": "PIN de acceso del chofer a la app (4-6 dígitos)"
    },
    "status": {
      "type": "string",
      "enum": [
        "disponible",
        "en_viaje",
        "no_disponible"
      ],
      "default": "disponible"
    },
    "dispatch_status": {
      "type": "string",
      "enum": [
        "normal",
        "automatic_pending"
      ],
      "default": "normal"
    },
    "reserved_order_id": {
      "type": "string"
    },
    "active_ride_id": {
      "type": "string"
    },
    "next_order_id": {
      "type": "string",
      "description": "Próximo pasaje tomado desde la cartelera de pendientes; no reemplaza el viaje activo"
    },
    "next_order_token": {
      "type": "string",
      "description": "Token exclusivo de la preasignación del próximo viaje"
    },
    "reservation_token": {
      "type": "string"
    },
    "driver_reservation_key": {
      "type": "string"
    },
    "driver_reservation_version": {
      "type": "number",
      "default": 0
    },
    "queue_position": {
      "type": "number"
    },
    "queue_authoritative_base": {
      "type": "string",
      "enum": [
        "1-Puerto",
        "2-Plaza",
        "3-Columna",
        "4-Base",
        "5-Cementerio",
        "6-Díaz Vélez",
        "7-Don Bosco",
        "8-Monumento"
      ],
      "description": "Base autoritativa de cola mantenida exclusivamente por el servidor"
    },
    "current_lat": {
      "type": "number"
    },
    "current_lng": {
      "type": "number"
    },
    "fcm_token": {
      "type": "string"
    },
    "device_id": {
      "type": "string"
    },
    "current_session_token": {
      "type": "string"
    },
    "last_active": {
      "type": "string",
      "format": "date"
    },
    "bloqueo_post_aceptacion_hasta": {
      "type": "number",
      "description": "Timestamp (ms) hasta el cual el chofer está bloqueado para nuevos pasajes y quedar libre"
    }
  },
  "required": [
    "name",
    "phone",
    "vehicle_plate"
  ]
}
