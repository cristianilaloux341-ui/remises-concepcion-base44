{
  "name": "Driver",
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": null,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "properties": {
    "name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "phone2": {
      "type": "string",
      "description": "Tel\u00e9fono de contacto secundario"
    },
    "fecha_nacimiento": {
      "type": "string",
      "format": "date",
      "description": "Fecha de nacimiento del conductor"
    },
    "dni": {
      "type": "string",
      "description": "N\u00famero de DNI"
    },
    "direccion": {
      "type": "string",
      "description": "Direcci\u00f3n del conductor"
    },
    "photo_url": {
      "type": "string",
      "description": "URL de la foto del conductor"
    },
    "carnet_categoria": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F",
        "G"
      ],
      "description": "Categor\u00eda del carnet de conducir"
    },
    "vehicle_model": {
      "type": "string",
      "description": "ID del m\u00f3vil asignado"
    },
    "vehicle_plate": {
      "type": "string"
    },
    "vehicle_color": {
      "type": "string"
    },
    "seguro_riesgos_personales_vencimiento": {
      "type": "string",
      "format": "date",
      "description": "Vencimiento seguro de riesgos personales del conductor"
    },
    "buena_conducta": {
      "type": "boolean",
      "default": true,
      "description": "Certificado de buena conducta vigente"
    },
    "buena_conducta_vencimiento": {
      "type": "string",
      "format": "date",
      "description": "Vencimiento buena conducta"
    },
    "notas": {
      "type": "string",
      "description": "Notas internas de la comisi\u00f3n"
    },
    "pin": {
      "type": "string",
      "description": "PIN de acceso del chofer a la app (4-6 d\u00edgitos)"
    },
    "status": {
      "type": "string",
      "enum": [
        "disponible",
        "en_viaje",
        "no_disponible"
      ],
      "default": "disponible"
    },
    "dispatch_status": {
      "type": "string",
      "enum": [
        "normal",
        "automatic_pending",
        "manual_pending"
      ],
      "default": "normal"
    },
    "modo_despacho": {
      "type": "string",
      "enum": [
        "automatico",
        "manual"
      ],
      "default": "automatico"
    },
    "reserved_order_id": {
      "type": "string"
    },
    "active_ride_id": {
      "type": "string"
    },
    "next_order_id": {
      "type": "string",
      "description": "Pr\u00f3ximo pasaje tomado desde la cartelera de pendientes; no reemplaza el viaje activo"
    },
    "next_order_token": {
      "type": "string",
      "description": "Token exclusivo de la preasignaci\u00f3n del pr\u00f3ximo viaje"
    },
    "reservation_token": {
      "type": "string"
    },
    "manual_reservation_token": {
      "type": "string"
    },
    "driver_reservation_key": {
      "type": "string"
    },
    "driver_reservation_version": {
      "type": "number",
      "default": 0
    },
    "current_base": {
      "type": "string",
      "enum": [
        "1-Puerto",
        "2-Plaza",
        "3-Columna",
        "4-Base",
        "5-Cementerio",
        "6-D\u00edaz V\u00e9lez",
        "7-Don Bosco",
        "8-Monumento"
      ]
    },
    "queue_position": {
      "type": "number"
    },
    "queue_entered_at": {
      "type": "string"
    },
    "queue_authoritative_base": {
      "type": "string",
      "enum": [
        "1-Puerto",
        "2-Plaza",
        "3-Columna",
        "4-Base",
        "5-Cementerio",
        "6-D\u00edaz V\u00e9lez",
        "7-Don Bosco",
        "8-Monumento"
      ],
      "description": "Base autoritativa de cola mantenida por servidor; APK legacy no debe modificarla"
    },
    "queue_authoritative_at": {
      "type": "string",
      "description": "Timestamp hist\u00f3rico/proyecci\u00f3n legacy para APK v12.27/v12.29; no decide prioridad ni despacho"
    },
    "queue_left_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "Hora hist\u00f3rica de salida de la base. No conserva posici\u00f3n ni prioridad; la cola operativa se define \u00fanicamente por current_base + queue_position del servidor."
    },
    "queue_authority_marker": {
      "type": "number",
      "description": "\u00daltimo marcador manual de cola aceptado por el servidor"
    },
    "manual_reorder_token": {
      "type": "string",
      "description": "Firma HMAC server-side del \u00faltimo reordenamiento manual autorizado por manualReorderDriverQueue. Null para escrituras t\u00e9cnicas."
    },
    "manual_reorder_at": {
      "type": "string",
      "description": "ISO timestamp del \u00faltimo reorden manual autorizado."
    },
    "current_lat": {
      "type": "number"
    },
    "current_lng": {
      "type": "number"
    },
    "user_id": {
      "type": "string"
    },
    "push_subscription": {
      "type": "string"
    },
    "fcm_token": {
      "type": "string"
    },
    "device_id": {
      "type": "string"
    },
    "current_session_token": {
      "type": "string"
    },
    "last_active": {
      "type": "string",
      "format": "date"
    },
    "bloqueo_post_aceptacion_hasta": {
      "type": "number",
      "description": "Timestamp (ms) hasta el cual el chofer est\u00e1 bloqueado para nuevos pasajes y quedar libre"
    },
    "last_queue_penalty_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "Clave idempotente de la \u00faltima penalizaci\u00f3n de cola aplicada por rechazo/timeout"
    },
    "last_queue_penalty_base": {
      "type": [
        "string",
        "null"
      ],
      "description": "Base donde se aplic\u00f3 la \u00faltima penalizaci\u00f3n idempotente de cola"
    }
  },
  "required": [
    "name",
    "phone",
    "vehicle_plate"
  ]
}