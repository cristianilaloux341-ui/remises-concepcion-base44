{
  "name": "Client",
  "type": "object",
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "properties": {
    "name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "password_hash": {
      "type": "string",
      "description": "Hash de la contraseña de acceso"
    },
    "pickup_address": {
      "type": "string",
      "description": "Dirección habitual de recogida"
    },
    "total_trips": {
      "type": "number",
      "default": 0
    },
    "cancelled_trips": {
      "type": "number",
      "default": 0
    },
    "complaints": {
      "type": "number",
      "default": 0
    },
    "score": {
      "type": "number",
      "default": 5,
      "description": "Puntuación del 1 al 10"
    },
    "preferred_driver_id": {
      "type": "string",
      "description": "ID del móvil preferido"
    },
    "preferred_driver_name": {
      "type": "string"
    },
    "blacklisted": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "fcm_token": {
      "type": "string",
      "description": "Token FCM del dispositivo del cliente para notificaciones nativas"
    }
  },
  "required": [
    "name"
  ]
}