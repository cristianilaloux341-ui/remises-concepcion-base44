{
  "name": "Client",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "password_hash": {
      "type": "string",
      "description": "Hash de la contrase\u00f1a de acceso"
    },
    "pickup_address": {
      "type": "string",
      "description": "Direcci\u00f3n habitual de recogida"
    },
    "total_trips": {
      "type": "number",
      "default": 0
    },
    "cancelled_trips": {
      "type": "number",
      "default": 0
    },
    "complaints": {
      "type": "number",
      "default": 0
    },
    "score": {
      "type": "number",
      "default": 5,
      "description": "Puntuaci\u00f3n del 1 al 10"
    },
    "preferred_driver_id": {
      "type": "string",
      "description": "ID del m\u00f3vil preferido"
    },
    "preferred_driver_name": {
      "type": "string"
    },
    "blacklisted": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}