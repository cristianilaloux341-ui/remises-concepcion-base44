{
  "name": "ProtocolTrace",
  "type": "object",
  "properties": {
    "correlationId": {
      "type": "string"
    },
    "invocationId": {
      "type": "string"
    },
    "traceSequence": {
      "type": "number"
    },
    "timestamp": {
      "type": "string"
    },
    "step": {
      "type": "string"
    },
    "operationKey": {
      "type": "string"
    },
    "filterCAS": {
      "type": "object",
      "additionalProperties": true
    },
    "casUpdatedCount": {
      "type": "number"
    },
    "casUpdateSucceeded": {
      "type": "boolean"
    },
    "executionResult": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "SKIPPED",
        "FAILED"
      ]
    },
    "executionDurationMs": {
      "type": "number"
    },
    "error": {
      "type": "string"
    },
    "snapshotBefore": {
      "type": "object",
      "additionalProperties": true
    },
    "snapshotAfter": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}