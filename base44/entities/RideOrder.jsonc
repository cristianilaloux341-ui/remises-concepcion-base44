{
  "name": "RideOrder",
  "type": "object",
  "properties": {
    "client_name": {
      "type": "string"
    },
    "pickup_address": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendiente",
        "procesando_despacho",
        "esperando_confirmacion_manual",
        "preasignado_proximo",
        "ofrecido",
        "aceptado",
        "en_camino",
        "en_viaje",
        "completado",
        "cancelado",
        "rechazado"
      ],
      "default": "pendiente"
    },
    "driver_id": {
      "type": "string"
    },
    "driver_name": {
      "type": "string"
    },
    "reserved_driver_id": {
      "type": "string"
    },
    "assignment_attempt": {
      "type": "number",
      "default": 1
    },
    "offerExpiresAt": {
      "type": [
        "number",
        "null"
      ]
    },
    "offered_driver_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "client_name",
    "pickup_address"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}