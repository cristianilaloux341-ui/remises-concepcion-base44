{
  "name": "RideOrder",
  "type": "object",
  "properties": {
    "client_name": {
      "type": "string"
    },
    "client_phone": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "pickup_address": {
      "type": "string"
    },
    "pickup_lat": {
      "type": "number"
    },
    "pickup_lng": {
      "type": "number"
    },
    "dropoff_address": {
      "type": "string"
    },
    "dropoff_addresses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dropoff_lat": {
      "type": "number"
    },
    "dropoff_lng": {
      "type": "number"
    },
    "zone": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendiente",
        "procesando_despacho",
        "preasignado_proximo",
        "ofrecido",
        "aceptado",
        "en_camino",
        "en_viaje",
        "completado",
        "cancelado"
      ],
      "default": "pendiente"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "Efectivo",
        "Transferencia"
      ],
      "default": "Efectivo"
    },
    "reservation_token": {
      "type": "string"
    },
    "reserved_driver_id": {
      "type": "string"
    },
    "preassigned_driver_id": {
      "type": "string"
    },
    "second_slot_offer": {
      "type": "boolean",
      "default": false
    },
    "preassignment_token": {
      "type": "string"
    },
    "preassigned_at": {
      "type": "string"
    },
    "assigned_base": {
      "type": "string"
    },
    "driver_id": {
      "type": "string"
    },
    "driver_name": {
      "type": "string"
    },
    "accepted_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "Instante autoritativo de aceptaci\u00f3n; origen de los tiempos configurados por Central"
    },
    "en_camino_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "Instante autoritativo en que pas\u00f3 a En camino"
    },
    "offered_driver_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fare": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "claimed_from_pending": {
      "type": "boolean"
    },
    "source": {
      "type": "string",
      "enum": [
        "operador",
        "cliente"
      ]
    },
    "assignment_attempt": {
      "type": "number",
      "default": 1
    },
    "offerExpiresAt": {
      "type": [
        "number",
        "null"
      ]
    },
    "push_ack_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "push_ack_assignment_attempt": {
      "type": [
        "number",
        "null"
      ]
    },
    "alert_presented_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "alert_presented_assignment_attempt": {
      "type": [
        "number",
        "null"
      ]
    },
    "alert_presented_protocol_attempt": {
      "type": [
        "number",
        "null"
      ]
    },
    "delivery_retry_count": {
      "type": "number",
      "default": 0
    },
    "processingOwnerId": {
      "type": [
        "string",
        "null"
      ]
    },
    "processingLeaseVersion": {
      "type": "number",
      "default": 0
    },
    "processingLeaseExpiresAt": {
      "type": [
        "number",
        "null"
      ]
    },
    "processingAction": {
      "type": [
        "string",
        "null"
      ]
    },
    "processingPhase": {
      "type": [
        "string",
        "null"
      ]
    },
    "processingOperationKey": {
      "type": [
        "string",
        "null"
      ]
    },
    "lastCompletedOperationKey": {
      "type": [
        "string",
        "null"
      ]
    },
    "lastCompletedAction": {
      "type": [
        "string",
        "null"
      ]
    },
    "lastCompletedResult": {
      "type": [
        "string",
        "null"
      ]
    },
    "lastCompletedOfferVersion": {
      "type": [
        "number",
        "null"
      ]
    },
    "cancel_effects_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "PENDING",
        "DONE",
        null
      ],
      "description": "Estado durable de los efectos secundarios de una cancelaci\u00f3n autoritativa"
    },
    "cancel_effects_operation_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "cancel_push_claimed": {
      "type": "boolean",
      "default": false
    },
    "cancel_push_claimed_at": {
      "type": [
        "number",
        "null"
      ]
    },
    "cancel_requeue_done": {
      "type": "boolean",
      "default": false,
      "description": "Marca durable: el reingreso primero por cancelacion de Central ya fue aplicado"
    },
    "pending_reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "CHAIN_EXHAUSTED",
        "MANUAL_RETURN",
        "ZONE_0_DIRECT_PENDING",
        "ZONE_EXHAUSTED_AT_CREATE",
        "MANUAL_ASSIGN_FAILED",
        "REQUESTED_DRIVER_NOT_ACCEPTED",
        null
      ],
      "description": "Clasificaci\u00f3n server-side de Pendiente; REQUESTED_DRIVER_NOT_ACCEPTED queda retenido s\u00f3lo para Central"
    },
    "requested_driver_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Driver pedido expresamente por el cliente; no equivale a asignaci\u00f3n manual de Central"
    },
    "requested_driver_only": {
      "type": "boolean",
      "default": false,
      "description": "Si el requerido no acepta, detener despacho autom\u00e1tico y retener para decisi\u00f3n del operador"
    },
    "importe_real_actual": {
      "type": "number"
    },
    "metros_taximetro": {
      "type": "number"
    },
    "segundos_espera_acumulados": {
      "type": "number"
    },
    "segundos_tolerancia_espera_usados": {
      "type": "number"
    },
    "ride_started_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "ride_finished_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "ride_duration_seconds": {
      "type": "number"
    },
    "max_speed_kmh": {
      "type": "number"
    },
    "driver_mobile": {
      "type": "string"
    },
    "driver_vehicle_plate": {
      "type": "string"
    },
    "taximetro_iniciado": {
      "type": "boolean"
    },
    "tarifa_bajada_snapshot": {
      "type": "number"
    },
    "tarifa_valor_ficha_snapshot": {
      "type": "number"
    },
    "tarifa_metros_por_ficha_snapshot": {
      "type": "number"
    },
    "tarifa_tolerancia_espera_segundos_snapshot": {
      "type": "number"
    },
    "tarifa_segundos_por_ficha_espera_snapshot": {
      "type": "number"
    },
    "tarifa_valor_ficha_espera_snapshot": {
      "type": "number"
    },
    "tarifa_snapshot_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "importe_calculo_servidor": {
      "type": [
        "number",
        "null"
      ]
    },
    "origen_calculo": {
      "type": "string"
    }
  },
  "required": [
    "client_name",
    "pickup_address"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}