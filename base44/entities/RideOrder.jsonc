{
  "name": "RideOrder",
  "type": "object",
  "rls": {
    "read": true,
    "create": false,
    "update": true,
    "delete": false
  },
  "properties": {
    "client_name": {
      "type": "string",
      "description": "Nombre del cliente"
    },
    "client_phone": {
      "type": "string",
      "description": "Tel\u00e9fono del cliente"
    },
    "client_id": {
      "type": "string",
      "description": "ID del cliente en la base de datos"
    },
    "pickup_address": {
      "type": "string",
      "description": "Direcci\u00f3n de recogida"
    },
    "pickup_lat": {
      "type": "number"
    },
    "pickup_lng": {
      "type": "number"
    },
    "dropoff_address": {
      "type": "string",
      "description": "Direcci\u00f3n de destino principal"
    },
    "dropoff_addresses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de destinos adicionales"
    },
    "dropoff_lat": {
      "type": "number"
    },
    "dropoff_lng": {
      "type": "number"
    },
    "zone": {
      "type": "string",
      "description": "Zona del viaje"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendiente",
        "ofrecido",
        "aceptado",
        "en_camino",
        "en_viaje",
        "completado",
        "cancelado",
        "rechazado"
      ],
      "default": "pendiente"
    },
    "assigned_base": {
      "type": "string",
      "description": "Base desde donde sale el chofer"
    },
    "driver_id": {
      "type": "string"
    },
    "driver_name": {
      "type": "string"
    },
    "offered_driver_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de choferes a quienes se ofreci\u00f3 el viaje"
    },
    "fare": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "operador",
        "cliente"
      ],
      "default": "operador",
      "description": "Origen del pedido"
    }
  },
  "required": [
    "client_name",
    "pickup_address"
  ]
}