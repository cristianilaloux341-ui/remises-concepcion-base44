{
  "name": "Base",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "enum": [
        "1-Puerto",
        "2-Plaza",
        "3-Columna",
        "4-Base",
        "5-Cementerio",
        "6-D\u00edaz V\u00e9lez",
        "7-Don Bosco",
        "8-Monumento"
      ]
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "address": {
      "type": "string"
    },
    "dispatch_status": {
      "type": "string",
      "enum": [
        "libre",
        "procesando",
        "esperando_manual"
      ],
      "default": "libre"
    },
    "lock_token": {
      "type": "string"
    },
    "lock_expires_at": {
      "type": "number"
    },
    "active_order_id": {
      "type": "string"
    },
    "manual_reservation_token": {
      "type": "string"
    },
    "manual_requested_at": {
      "type": "number"
    },
    "manual_expires_at": {
      "type": "number"
    }
  },
  "required": [
    "name"
  ]
}