      "type": "string",
      "enum": [
        "1-Puerto",
        "2-Plaza",
        "3-Columna",
        "4-Base",
        "5-Cementerio",
        "6-Díaz Vélez",
        "7-Don Bosco",
        "8-Monumento"
      ]
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "address": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
