{
  "type": "object",
  "properties": {
    "address": {
      "type": "string",
      "description": "Direcci\u00f3n completa"
    },
    "normalized_address": {
      "type": "string",
      "description": "Clave normalizada para reutilizaci\u00f3n exacta"
    },
    "street": {
      "type": "string"
    },
    "height": {
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "zone": {
      "type": "string",
      "enum": [
        "1-Puerto",
        "2-Plaza",
        "3-Columna",
        "4-Base",
        "5-Cementerio",
        "6-D\u00edaz V\u00e9lez",
        "7-Don Bosco",
        "8-Monumento"
      ]
    },
    "zone_source": {
      "type": "string",
      "enum": [
        "memory",
        "polygon",
        "operator"
      ]
    },
    "zone_confirmed": {
      "type": "boolean",
      "default": false
    },
    "usage_count": {
      "type": "number",
      "default": 1
    },
    "last_used": {
      "type": "string"
    }
  },
  "required": [
    "address"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "AddressHistory"
}