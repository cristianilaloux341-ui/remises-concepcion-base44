{
  "name": "Movil",
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "properties": {
    "numero_movil": {
      "type": "number",
      "description": "Número de móvil"
    },
    "apellido_nombre": {
      "type": "string",
      "description": "Apellido y nombre del titular"
    },
    "dni": {
      "type": "string",
      "description": "DNI del titular"
    },
    "fecha_nacimiento": {
      "type": "string",
      "format": "date",
      "description": "Fecha de nacimiento del titular"
    },
    "direccion": {
      "type": "string",
      "description": "Dirección del titular"
    },
    "dominio": {
      "type": "string",
      "description": "Dominio/patente del vehículo"
    },
    "marca": {
      "type": "string",
      "description": "Marca del vehículo"
    },
    "modelo": {
      "type": "string",
      "description": "Modelo del vehículo"
    },
    "color": {
      "type": "string",
      "description": "Color del vehículo"
    },
    "carnet_categoria": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F",
        "G"
      ],
      "description": "Categoría del carnet de conducir"
    },
    "vtv_vencimiento": {
      "type": "string",
      "format": "date",
      "description": "Vencimiento VTV/RTO"
    },
    "seguro_riesgos_personales_vencimiento": {
      "type": "string",
      "format": "date",
      "description": "Vencimiento seguro de riesgos personales"
    },
    "seguro_automotor_vencimiento": {
      "type": "string",
      "format": "date",
      "description": "Vencimiento seguro automotor"
    },
    "pago_semanal_al_dia": {
      "type": "boolean",
      "default": true,
      "description": "Pago semanal al día"
    },
    "pago_semanal_fecha": {
      "type": "string",
      "format": "date",
      "description": "Fecha último pago semanal"
    },
    "deuda_monto": {
      "type": "number",
      "default": 0,
      "description": "Monto de deuda acumulada (en pesos)"
    },
    "deuda_notas": {
      "type": "string",
      "description": "Detalle de la deuda"
    },
    "buena_conducta": {
      "type": "boolean",
      "default": true,
      "description": "Certificado de buena conducta vigente"
    },
    "buena_conducta_vencimiento": {
      "type": "string",
      "format": "date",
      "description": "Vencimiento buena conducta"
    },
    "activo": {
      "type": "boolean",
      "default": true,
      "description": "Móvil activo en la flota (habilitado por operador/comisión)"
    },
    "suspension_motivo": {
      "type": "string",
      "description": "Motivo de suspensión ingresado por el operador"
    },
    "fuera_de_servicio": {
      "type": "boolean",
      "default": false,
      "description": "Fuera de servicio definitivo (solo comisión): falta de pago, papeles, etc."
    },
    "fuera_de_servicio_motivo": {
      "type": "string",
      "enum": [
        "falta_de_pago",
        "falta_de_papeles",
        "baja_voluntaria",
        "sancion_disciplinaria",
        "otro"
      ],
      "description": "Motivo por el que la comisión lo sacó de servicio"
    },
    "fuera_de_servicio_detalle": {
      "type": "string",
      "description": "Detalle adicional del motivo (comisión)"
    },
    "notas": {
      "type": "string",
      "description": "Observaciones adicionales"
    }
  },
  "required": [
    "numero_movil"
  ]
}
