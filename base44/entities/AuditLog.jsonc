{
  "name": "AuditLog",
  "type": "object",
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "properties": {
    "action": {
      "type": "string",
      "description": "Tipo de acci\u00f3n (ej: 'asignar_viaje', 'cancelar_viaje', 'modificar_tarifa')"
    },
    "user_type": {
      "type": "string",
      "description": "Rol de quien ejecut\u00f3 (ej: 'operador', 'admin', 'chofer', 'sistema')"
    },
    "user_name": {
      "type": "string"
    },
    "details": {
      "type": "string",
      "description": "Detalle en texto de la acci\u00f3n"
    },
    "device": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "description": "Datos estructurados para reconstrucci\u00f3n de trazas (tokens, IDs, matchedCount)"
    }
  },
  "required": [
    "action",
    "user_name"
  ]
}