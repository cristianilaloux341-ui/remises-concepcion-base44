{
  "name": "DispatchConfig",
  "type": "object",
  "properties": {
    "zone": {
      "type": "string"
    },
    "engineState": {
      "type": "string",
      "enum": [
        "active",
        "draining",
        "disabled"
      ],
      "default": "disabled",
      "description": "Estado del motor at\u00f3mico: active (toma viajes), draining (termina los suyos pero no toma nuevos), disabled (solo legacy)."
    },
    "enabledBaseIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Bases habilitadas para el piloto"
    },
    "enabledDriverIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Choferes habilitados para el piloto"
    },
    "pilotMode": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "zone"
  ]
}