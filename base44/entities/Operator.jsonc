{
  "name": "Operator",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre completo del operador"
    },
    "phone": {
      "type": "string",
      "description": "N\u00famero de celular (usado para ingresar)"
    },
    "email": {
      "type": "string",
      "description": "Correo electr\u00f3nico (para env\u00edo de acceso y login)"
    },
    "pin": {
      "type": "string",
      "description": "PIN num\u00e9rico de 4-6 d\u00edgitos"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "operador",
        "caja",
        "supervisor"
      ],
      "default": "operador",
      "description": "Rol en el sistema"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Habilitado para ingresar"
    },
    "notes": {
      "type": "string",
      "description": "Notas internas"
    },
    "last_active": {
      "type": "string",
      "format": "date",
      "description": "\u00daltima vez activo online"
    }
  },
  "required": [
    "name",
    "phone"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}