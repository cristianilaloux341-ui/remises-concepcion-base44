{
  "name": "Message",
  "type": "object",
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "properties": {
    "from_type": {
      "type": "string",
      "enum": [
        "operador",
        "movil",
        "cliente"
      ],
      "description": "Quién envía"
    },
    "from_name": {
      "type": "string"
    },
    "driver_id": {
      "type": "string",
      "description": "ID del móvil. Se conserva por compatibilidad con la mensajería actual de choferes."
    },
    "to_driver_id": {
      "type": "string",
      "description": "ID del móvil destinatario cuando el operador escribe a un móvil específico; vacío para broadcast."
    },
    "client_id": {
      "type": "string",
      "description": "ID exclusivo del cliente cuando el mensaje pertenece a la app de clientes."
    },
    "to_client_id": {
      "type": "string",
      "description": "ID exclusivo del cliente destinatario cuando operador/base responde a un cliente."
    },
    "content": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "from_type",
    "from_name",
    "content"
  ]
}