{
  "name": "Message",
  "type": "object",
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "properties": {
    "from_type": {
      "type": "string",
      "enum": [
        "operador",
        "movil",
        "cliente"
      ],
      "description": "Qui\u00e9n env\u00eda"
    },
    "from_name": {
      "type": "string"
    },
    "driver_id": {
      "type": "string",
      "description": "ID del m\u00f3vil (si es movil) o del cliente"
    },
    "to_driver_id": {
      "type": "string",
      "description": "Si el operador escribe a un m\u00f3vil espec\u00edfico, si vac\u00edo es broadcast"
    },
    "content": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
