{
  "name": "Deep Dispatch Reconciler",
  "description": "LEGACY DESHABILITADO 2026-09-22: no auto-despachar Pendientes ni reconciliar cola desde cambios gen\u00e9ricos de Driver",
  "trigger": {
    "condition": "${ false }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Driver"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "deep_dispatch_reconciler",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "dispatchPendingOnDriverQueueEntry",
            "args": {
              "event": "${ .trigger }",
              "data": "${ .trigger.data }",
              "old_data": "${ .trigger.old_data }",
              "driverId": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Reconciliar Despacho",
            "description": "Verifica cola y pendientes"
          }
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "dispatchReconciler"
  }
}