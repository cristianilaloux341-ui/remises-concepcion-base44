{
  "name": "Deep Dispatch Reconciler",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"queue_entered_at\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Driver"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "deep_dispatch_reconciler",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "dispatchPendingOnDriverQueueEntry",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "description": "",
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "dispatchReconciler"
  }
}