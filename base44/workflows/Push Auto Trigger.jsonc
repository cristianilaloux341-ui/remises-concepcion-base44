{
  "name": "Push Auto Trigger",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "push_auto_trigger",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendPushNotification",
            "args": {
              "source": "ride_order_workflow",
              "data": "${ .trigger.data }",
              "old_data": "${ .trigger.old_data }"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) or (.trigger.changed_fields | index(\"reserved_driver_id\") != null) or (.trigger.changed_fields | index(\"offered_driver_ids\") != null)) and (.trigger.data.status != \"cancelado\" or .trigger.old_data.status != \"cancelado\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "RideOrder"
    }
  },
  "description": "",
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendPushNotification"
  }
}