{
  "name": "Despachar Pendientes al Entrar Movil",
  "description": "Cuando un m\u00f3vil disponible entra o cambia de base, intenta despachar autom\u00e1ticamente el pendiente m\u00e1s antiguo de esa misma zona respetando la cola.",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"current_base\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Driver"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "despachar_pendientes_al_entrar_movil",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "dispatchPendingOnDriverQueueEntry",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}