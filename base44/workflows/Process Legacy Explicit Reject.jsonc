{
  "trigger": {
    "condition": "${ false }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "AuditLog"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "process_legacy_explicit_reject",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processLegacyExplicitReject",
            "args": {
              "data": "${ .trigger.data }"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "description": "Compatibilidad v12.27/v12.29: un rechazo expl\u00edcito registrado por la APK entra de inmediato al motor rejectRide, sin esperar el timeout.",
  "name": "Process Legacy Explicit Reject"
}